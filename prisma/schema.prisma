generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id            Int                 @id @default(autoincrement())
  nombre        String
  slug          String              @unique
  activo        Boolean             @default(true)
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt
  bots          Bot[]
  sesiones      ChatSession[]
  clientes      Cliente[]
  documentos    KnowledgeDocument[]
}

model Bot {
  id                  Int           @id @default(autoincrement())
  empresaId           Int
  nombre              String
  slug                String        @unique
  descripcion         String?
  provider            String        @default("fireworks")
  model               String        @default("accounts/fireworks/models/gpt-oss-120b")
  systemPrompt        String
  contextPrompt       String?
  historyPrompt       String?
  outputStyle         String?
  maxCompletionTokens Int?          @default(500)
  temperature         Float         @default(0.7)
  topP                Float?        @default(0.9)
  frequencyPenalty    Float?        @default(0.2)
  presencePenalty     Float?        @default(0.0)
  maxHistoryMessages  Int?          @default(15)
  status              BotStatus     @default(ACTIVE)
  creadoEn            DateTime      @default(now())
  actualizadoEn       DateTime      @updatedAt
  empresa             Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sesiones            ChatSession[]
}

model Cliente {
  id                 Int               @id @default(autoincrement())
  empresaId          Int
  nombre             String?
  telefono           String
  uuid               String?           @unique
  crmUsuarioId       Int?
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt
  botActivo          Boolean           @default(true)
  ultimoMensajeFecha DateTime          @default(now())
  sesiones           ChatSession[]
  empresa            Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  whatsappHistory    WhatsappMessage[]


  @@unique([empresaId, telefono])
}

model ChatSession {
  id                   Int               @id @default(autoincrement())
  empresaId            Int
  clienteId            Int?
  telefono             String
  canal                ChatChannel
  estado               ChatSessionStatus @default(OPEN)
  ultimoTicketCrmId    String?
  ultimoTicketCreadoEn DateTime?
  iniciadoEn           DateTime          @default(now())
  cerradoEn            DateTime?
  creadoEn             DateTime          @default(now())
  actualizadoEn        DateTime          @updatedAt
  botId                Int?
  flowContext          Json?
  flowIntent           ChatFlowIntent    @default(NONE)
  flowStep             ChatFlowStep      @default(NONE)
  mensajes             ChatMessage[]
  bot                  Bot?              @relation(fields: [botId], references: [id])
  cliente              Cliente?          @relation(fields: [clienteId], references: [id])
  empresa              Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  whatsappMessages     WhatsappMessage[]

  @@index([empresaId, telefono, canal, estado])
}

model ChatMessage {
  id            Int         @id @default(autoincrement())
  sessionId     Int
  rol           ChatRole
  contenido     String
  tokens        Int?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  mediaUrl      String?
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, creadoEn])
}

model KnowledgeDocument {
  id            Int                   @id @default(autoincrement())
  empresaId     Int
  tipo          KnowledgeDocumentType
  origen        String?
  titulo        String
  descripcion   String?
  creadoEn      DateTime              @default(now())
  actualizadoEn DateTime              @updatedAt
  externoId     Int?
  textoLargo    String?
  activo        Boolean               @default(true)
  chunks        KnowledgeChunk[]
  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, tipo])
}

model KnowledgeChunk {
  id            Int                   @id @default(autoincrement())
  documentId    Int
  indice        Int
  texto         String
  embedding     Unsupported("vector")
  tokens        Int?
  creadoEn      DateTime              @default(now())
  actualizadoEn DateTime              @updatedAt
  document      KnowledgeDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, indice])
}

/// ---------- WHATSAPPP: PERSISTENCIA DE CHATS ----------
model WhatsappMessage {
  wamid         String       @unique
  chatSessionId Int?
  clienteId     Int?
  direction     WazDirection
  from          String
  to            String
  type          WazMediaType
  body          String?
  mediaUrl      String?
  mediaMimeType String?
  mediaSha256   String?
  status        WazStatus    @default(SENT)
  errorCode     String?
  errorMessage  String?
  replyToWamid  String?
  timestamp     BigInt
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  id            Int          @id @default(autoincrement())
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id])
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])

  @@index([wamid])
  @@index([clienteId])
  @@index([status])
}

enum KnowledgeDocumentType {
  FAQ
  DOCUMENTO
  CONTRATO
  PLAN
  TICKET
  COBRO
  OTRO
  PROTOCOLO
  FUNCION
}

enum ChatFlowStep {
  NONE
  IDENTIFICACION
  DIAGNOSTICO
  CONFIRMACION
  ACCION
  CIERRE
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ChatChannel {
  WHATSAPP
  WEB
  TELEGRAM
  SMS
  OTHER
}

enum ChatSessionStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum BotStatus {
  ACTIVE
  DISABLED
}

enum WazDirection {
  INBOUND
  OUTBOUND
}

enum WazStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum WazMediaType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
  INTERACTIVE
  UNKNOWN
}

enum ChatFlowIntent {
  NONE
  SOPORTE
  VENTAS
  FACTURACION
  TIENDA
  INFORMACION
}
